{
  "name": "workcopilot",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test server/*.test.mjs server/eval/*.test.mjs src/pages/work/projects/*.test.mjs src/pages/work/pm/*.test.mjs src/pages/work/teach/*.test.mjs src/shared/*.test.mjs src/theme/*.test.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "check:jsx-imports": "node scripts/check-jsx-imports.mjs",
    "check:locale-integrity": "node scripts/check-locale-integrity.mjs",
    "prebuild": "node scripts/check-jsx-imports.mjs && node scripts/check-css-page-wildcards.mjs && node scripts/check-cssjs-backticks.mjs && node scripts/check-locale-integrity.mjs && node scripts/check-locale-parity.mjs && node scripts/check-hardcoded-strings.mjs && node scripts/check-mounted-ref-effects.mjs",
    "build": "vite build",
    "build:harden": "vite build --mode harden",
    "build:harden:max": "vite build --mode hardenmax",
    "check:public-assets": "node scripts/check-public-assets.mjs",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.18",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.427.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "javascript-obfuscator": "^5.2.1",
    "vite": "^8.3.5"
  }
}
