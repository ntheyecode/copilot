{
  "name": "workcopilot",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test server/*.test.mjs server/eval/*.test.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "check:jsx-imports": "node scripts/check-jsx-imports.mjs",
    "prebuild": "node scripts/check-jsx-imports.mjs",
    "build": "vite build",
    "check:public-assets": "node scripts/check-public-assets.mjs",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.18",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.427.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
