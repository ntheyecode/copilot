# WorkCoPilot standalone server - environment variables.
# Copy to .env (or set these in the service unit) and fill in as needed.
# Nothing here is required to boot in dev: sensible defaults are used.

# Port the Express API listens on. Dev default is 4444 to match the Vite proxy
# in vite.config.js ( /api -> http://localhost:4444 ). In production nginx
# serves the built static files and proxies /api to this port.
PORT=4444

# Session cookie signing secret. If unset, a secret is generated once and
# persisted in the data dir (db.json), so sessions survive restarts either way.
# Set this explicitly in production (any long random string).
SESSION_SECRET=

# Where the database (db.json), uploaded reference docs, per-step screenshots
# and the optional ai-seed.json live. Defaults to ./server/data. Point this at
# the save/handoff drive in production. Run worktrees/venvs from SSD, but the
# data dir can live wherever you keep state.
WORK_DATA_DIR=

# Set to 1 when hosted behind TLS (nginx). Marks the session cookie Secure and
# trusts the proxy for req.protocol. Also makes first-boot generate (and print
# once) a random superadmin password instead of using "admin".
WORK_HOSTED=

# Public base URL of the deployed site (used for absolute links in app/share
# surfaces). Informational; no default.
WORK_PUBLIC_URL=

# First-boot superadmin password. When unset: "admin" locally, or a random
# printed-once password when WORK_HOSTED=1. Ignored after the account exists.
WORK_ADMIN_PASSWORD=

# Optional: a Tavily API key (https://tavily.com) to enable live web grounding
# for Plan / How-to / Research. When unset, those features still work from the
# model's own knowledge; no web search is performed.
WORK_TAVILY_KEY=

# ---------------------------------------------------------------------------
# STRIPE BILLING (subscriptions). All optional: when STRIPE_SECRET_KEY is unset
# the server still boots and runs, but starting a session returns a clear
# "subscription needed" message and /checkout returns a 503 "not configured yet".
# Run `npm install stripe` once, then set these. See BILLING-NOTES.md.
#   success_url = <WORK_PUBLIC_URL or https://admireveda.com>/work?checkout=success
#   cancel_url  = <WORK_PUBLIC_URL or https://admireveda.com>/#pricing
#   webhook     = <site>/api/work/stripe/webhook
#   The subscribe onboarding (/workcopilot/signup) returns to
#   <site>/workcopilot/signup/pay?checkout=success|cancel and confirms the
#   payment server-side from Stripe (docs/onboarding-flow.md). Same keys, same
#   price ids, same webhook; nothing extra to configure in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_ADVANCED=
STRIPE_PRICE_PREMIUM=

# ---------------------------------------------------------------------------
# AI SEED (not an env var): to configure the platform AI at deploy, drop a file
# named  ai-seed.json  into WORK_DATA_DIR. It is loaded ONCE, only while no
# platform key is configured yet (a superadmin's later change is never
# overwritten). Shape:
#
# {
#   "platformAiAllowed": true,
#   "activeProvider": "gemini",
#   "systemPrompt": "optional override of the base guide prompt",
#   "providers": {
#     "gemini": { "apiKey": "AIza...", "chatModel": "gemini-2.0-flash", "visionModel": "gemini-2.0-flash" },
#     "openai": { "apiKey": "sk-...",  "chatModel": "gpt-4o-mini",      "visionModel": "gpt-4o-mini" },
#     "groq":   { "apiKey": "gsk_..." }
#   }
# }
#
# Each provider needs at least an apiKey; chatModel / visionModel are optional
# pins (left null, the server resolves a good default and a vision-capable model
# from the provider's live catalog). Never commit a real key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY: append every templated email (verification codes,
# reset links) as JSON lines to this file so the sign-up flow can be exercised
# without SMTP. Ignored when WORK_HOSTED=1 or NODE_ENV=production.
WORK_EMAIL_SINK_FILE=
