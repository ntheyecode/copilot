<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No ActionBar: the web app owns the full chrome. Dark window background
         so there is no white flash before the WebView paints. -->
    <style name="Theme.WorkCoPilot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/wc_background</item>
        <item name="android:statusBarColor">@color/wc_background</item>
        <item name="android:navigationBarColor">@color/wc_background</item>
    </style>
</resources>
