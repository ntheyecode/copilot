{
  "name": "workcopilot-desktop",
  "version": "1.0.6",
  "private": true,
  "description": "WorkCoPilot desktop - an always-on-top, read-only overlay that loads the WorkCoPilot web console (/work). Opacity + interact-behind (click-through) so it floats over the app you are working in; content-protected so it stays out of its own screen capture.",
  "main": "main.js",
  "author": "COE Security LLC",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.workcopilot.desktop",
    "productName": "WorkCoPilot",
    "publish": [
      {
        "provider": "generic",
        "url": "https://admireveda.com/work-updates/"
      }
    ],
    "directories": {
      "output": "release-workcopilot"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "ocr-lang/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "msi"
      ],
      "signtoolOptions": {
        "certificateSha1": "71D78BF55B844DCEEC51ED85DD664BD617C5C71D",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "publisherName": "COE Security LLC"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "WorkCoPilot-Setup.exe",
      "menuCategory": false,
      "runAfterFinish": true
    },
    "msi": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": false,
      "artifactName": "WorkCoPilot-Setup.msi",
      "upgradeCode": "E5EBB1F4-4997-4401-931C-11D8A935FF87"
    }
  }
}
